# MicroShift's node IP on lo. dns is a placeholder so resolv.conf is never empty;
# priority 200 sorts it after eth0's. From `nmcli --offline connection add`.
[connection]
id=stable-microshift
uuid=49e4d03f-09ab-4246-b810-a6e04a3c7544
type=loopback
interface-name=lo

[loopback]

[ipv4]
address1=10.44.0.1/32
dns=10.44.1.1;
dns-priority=200
ignore-auto-dns=true
method=manual

[ipv6]
addr-gen-mode=default
method=auto

[proxy]
