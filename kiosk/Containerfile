# Layer 3, shared: Firefox fullscreen on the DisplayPort output, started when a
# monitor is plugged in and stopped when it is unplugged. Below the Kubernetes
# variant, because nothing here is about the cluster: an app or service change
# never re-runs this install.
#
# No GPU, by construction: the GPU is Triton's. Xorg's modesetting driver with
# acceleration off, Mesa's software GL for GNOME Kiosk, Firefox's software
# WebRender. The display controller that scans the picture out is separate
# hardware and costs the model nothing.
ARG BASE_IMAGE=ghcr.io/black-cloudlet/jetson-orin-bootc-bound-images:latest
FROM ${BASE_IMAGE}

# GNOME Kiosk is the window manager: without one, GTK's fullscreen request goes
# to nobody and Firefox opens as a window, and nothing turns on a monitor
# plugged in after X started. It is the only one RHEL ships for this.
# mesa-dri-drivers is the software renderer it draws with. DejaVu Sans covers
# Latin and Hebrew; the frontend must bundle any other font it wants.
# No weak deps: they are most of a desktop.
RUN dnf install -y --setopt=install_weak_deps=False \
        firefox gnome-kiosk mesa-dri-drivers dejavu-sans-fonts \
        xorg-x11-server-Xorg xorg-x11-drv-libinput xorg-x11-xinit && \
    dnf clean all

# The account the session runs as: no password, no shell, not in wheel.
COPY kiosk/sysusers.conf /usr/lib/sysusers.d/jetson-kiosk.conf

# In /usr: image content. A device that needs another driver setting overrides
# it from /etc/X11/xorg.conf.d.
COPY kiosk/xorg.conf /usr/share/X11/xorg.conf.d/90-jetson-kiosk.conf

# JSON takes no comments, so the why is here. Hardware acceleration off and
# software WebRender: no GPU. Disk cache off, with session.sh's fresh profile
# on tmpfs: no eMMC writes. Updates, telemetry, studies, safe browsing and the
# OpenH264 download: all would try the internet. No crash restore: a restarted
# session opens the URL, not an offer to restore the last one. The rest keeps a
# kiosk user from anything but the page. /etc/firefox/policies is read before
# the copy in Firefox's own directory.
COPY kiosk/policies.json /etc/firefox/policies/policies.json

# /etc, so one device can point somewhere else without a rebuild.
COPY kiosk/jetson-kiosk.conf /etc/jetson-kiosk.conf

COPY --chmod=0555 kiosk/kiosk.sh   /opt/jetson-kiosk/kiosk.sh
COPY --chmod=0555 kiosk/session.sh /opt/jetson-kiosk/session.sh
COPY --chmod=0644 kiosk/jetson-kiosk.service \
      /usr/lib/systemd/system/jetson-kiosk.service
RUN systemctl enable jetson-kiosk.service

RUN bootc container lint
