# Layer 3, microshift variant: MicroShift 4.20 and the NVIDIA device plugin.
# services/ stacks what runs on the cluster on top.
ARG BASE_IMAGE=ghcr.io/black-cloudlet/jetson-orin-bootc-bound-images:latest
FROM ${BASE_IMAGE}

# Both repos are entitlement-gated; the build registers. No `dnf upgrade`: it
# could pull a kernel the Tegra kmod cannot load against. --enablerepo rather
# than config-manager, so dnf-plugins-core need not be in the base.
# openshift-clients is `oc` — the microshift RPM ships no client.
ARG USHIFT_VER=4.20
RUN dnf install -y \
        --enablerepo="rhocp-${USHIFT_VER}-for-rhel-9-$(uname -m)-rpms" \
        --enablerepo="fast-datapath-for-rhel-9-$(uname -m)-rpms" \
        firewalld jq microshift microshift-release-info openshift-clients && \
    systemctl enable microshift && \
    dnf clean all

# Trusted: pod CIDR and host endpoint are mandatory, the service CIDR is how
# pods reach CoreDNS and the API. Public: ssh, the router, the API.
RUN firewall-offline-cmd --zone=trusted --add-source=10.42.0.0/16 && \
    firewall-offline-cmd --zone=trusted --add-source=10.43.0.0/16 && \
    firewall-offline-cmd --zone=trusted --add-source=169.254.169.1 && \
    firewall-offline-cmd --zone=public --add-port=22/tcp && \
    firewall-offline-cmd --zone=public --add-port=443/tcp && \
    firewall-offline-cmd --zone=public --add-port=6443/tcp

# Installs the lo connection (0600, root-only) and MicroShift's nodeIP drop-in.
COPY --chmod=0600 microshift/stable-microshift.nmconnection \
      /usr/lib/NetworkManager/system-connections/stable-microshift.nmconnection
COPY microshift/config.d/ /etc/microshift/config.d/

# OVN needs the root subtree shared; on bare metal systemd has already done it.
COPY <<'EOF' /usr/lib/systemd/system/microshift-make-rshared.service
[Unit]
Description=Make root filesystem shared
Before=microshift.service
ConditionVirtualization=container

[Service]
Type=oneshot
ExecStart=/usr/bin/mount --make-rshared /

[Install]
WantedBy=multi-user.target
EOF

RUN systemctl enable microshift-make-rshared.service

# Do not start before the embedded images have been replayed.
COPY <<'EOF' /usr/lib/systemd/system/microshift.service.d/microshift-copy-images.conf
[Unit]
Requires=copy-embedded-images.service
After=copy-embedded-images.service
EOF

# CRI-O needs the NVIDIA runtime before a pod can ask for a GPU. Ask for the
# .toml name: nvidia-ctk renames a .conf drop-in and still exits 0.
ARG NVIDIA_DEVICE_PLUGIN_VER=v0.17.1
RUN nvidia-ctk runtime configure --runtime=crio --set-as-default \
        --config=/etc/crio/crio.conf.d/99-nvidia.toml

RUN mkdir -p /etc/microshift/manifests && \
    curl -fsSL -o /etc/microshift/manifests/nvidia-device-plugin.yml \
      "https://raw.githubusercontent.com/NVIDIA/k8s-device-plugin/${NVIDIA_DEVICE_PLUGIN_VER}/deployments/static/nvidia-device-plugin.yml"

# Kustomization, time-slicing ConfigMap and the patch that mounts it — the
# upstream manifest above is patched, never forked.
COPY microshift/manifests/ /etc/microshift/manifests/

# Kept in the image so the smoke test can ask what the build asked. services/
# runs it from here too.
COPY --chmod=0555 microshift/manifest-images.sh \
      /opt/microshift/manifest-images.sh

# release-info lists the control plane only; the device plugin is named nowhere
# but in the manifest that deploys it. The paths are the ones MicroShift renders
# at start-up. && and the exit: a `;` chain would hide a copy that failed.
RUN --mount=type=secret,id=pullsecret,dst=/run/secrets/pull-secret.json \
    images="$(jq -r '.images[]' /usr/share/microshift/release/release-"$(uname -m)".json)" && \
    images="${images} $(/opt/microshift/manifest-images.sh \
        /usr/lib/microshift/manifests /usr/lib/microshift/manifests.d/*/ \
        /etc/microshift/manifests /etc/microshift/manifests.d/*/)" && \
    for img in ${images} ; do \
        /opt/physically-bound-images/embed_image.sh "${img}" \
            --authfile /run/secrets/pull-secret.json || exit 1 ; \
    done

RUN bootc container lint
