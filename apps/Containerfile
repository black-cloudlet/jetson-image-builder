# 2/3. Image-embedding machinery and the application images every variant needs.
# Separate from the variant layer so changing an app image does not re-pull a
# whole Kubernetes control plane.
ARG BASE_IMAGE=ghcr.io/black-cloudlet/jetson-orin-bootc-base:latest
FROM ${BASE_IMAGE}

# Nodes have no network at first boot, so images are copied to disk now and
# replayed into containers-storage at boot. A build cannot `podman pull`:
# overlayfs on overlayfs, and vfs would cost image size x layer count. The cache
# is not a real container store because an image upgrade overwrites an
# additional store (RHEL-75827).
# Scripts from redhat-et/edge-ai-image-pipelines (Apache-2.0).
COPY --chmod=0555 physically-bound-images/embed_image.sh \
      /opt/physically-bound-images/embed_image.sh
COPY --chmod=0555 physically-bound-images/copy_embedded_images.sh \
      /opt/physically-bound-images/copy_embedded_images.sh

# No network-online: the copy is local-disk only, and waiting for a carrier that
# never comes would add wait-online's timeout to every boot.
RUN printf '[Unit]\n\
Description=Copy embedded container images into containers-storage\n\
Wants=basic.target\n\
After=basic.target local-fs.target\n\
[Service]\n\
Type=oneshot\n\
ExecStart=/opt/physically-bound-images/copy_embedded_images.sh\n\
RemainAfterExit=yes\n\
[Install]\n\
WantedBy=multi-user.target\n' > /usr/lib/systemd/system/copy-embedded-images.service && \
    systemctl enable copy-embedded-images.service

# PostgreSQL, RabbitMQ, KServe and the model server go here, pinned by digest.
ARG APP_IMAGES=""
RUN --mount=type=secret,id=pullsecret,dst=/run/secrets/pull-secret.json \
    for img in ${APP_IMAGES} ; do \
        /opt/physically-bound-images/embed_image.sh "${img}" \
            --authfile /run/secrets/pull-secret.json ; \
    done

RUN bootc container lint
