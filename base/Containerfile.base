# Layer 1, shared. The vendor image republished under our own name: the pin
# lives in one place, and the air-gapped mirror gets a name we control.
#
# Pinned deliberately — the Tegra kmod is built against this exact kernel, so a
# floating tag is a silent GPU break. Adds nothing: the vendor image already
# carries the kmods, CUDA userspace and nvidia-ctk.
ARG BASE=quay.io/redhat-user-workloads/jetpack-for-rhel-tenant/rhel-98-bootc:6.2.2_5.14.0-687.42.1_090326003719
FROM ${BASE}

RUN bootc container lint
