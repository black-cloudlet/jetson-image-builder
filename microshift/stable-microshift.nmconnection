# MicroShift's node IP, on lo so a pulled cable never takes it away.
# Generated by, and equivalent to, Red Hat's fully-disconnected procedure:
#   nmcli --offline connection add type loopback con-name stable-microshift ifname lo \
#       ip4 10.44.0.1/32 ipv4.ignore-auto-dns yes ipv4.dns 10.44.1.1 ipv4.dns-priority 200
# dns is a placeholder so resolv.conf is never empty once eth0 is down; priority
# 200 sorts it after eth0's 192.168.1.1 (default 100) while connected.
[connection]
id=stable-microshift
uuid=49e4d03f-09ab-4246-b810-a6e04a3c7544
type=loopback
interface-name=lo

[loopback]

[ipv4]
address1=10.44.0.1/32
dns=10.44.1.1;
dns-priority=200
ignore-auto-dns=true
method=manual

[ipv6]
addr-gen-mode=default
method=auto

[proxy]
