# Layer 3, shared: Firefox fullscreen on the DisplayPort output, Red Hat's
# documented kiosk (GDM login, GNOME Kiosk's script session). Below the
# variant: nothing here is about the cluster.
ARG BASE_IMAGE=ghcr.io/black-cloudlet/jetson-orin-bootc-bound-images:latest
FROM ${BASE_IMAGE}

# The kiosk password's hash, root-only, for sysusers. Checked before dnf.
RUN --mount=type=secret,id=kiosk_password_hash \
    hash=$(cat /run/secrets/kiosk_password_hash 2>/dev/null || true) && \
    case $hash in \
      *[[:space:]]*|'') echo "JETSON_KIOSK_PASSWORD_HASH is empty or has whitespace"; exit 1 ;; \
      '$'?*'$'?*'$'?*) ;; \
      *) echo "JETSON_KIOSK_PASSWORD_HASH is not a crypt hash (openssl passwd -6)"; exit 1 ;; \
    esac && \
    install -d -m 0755 /usr/lib/jetson-kiosk && \
    install -m 0600 /dev/null /usr/lib/jetson-kiosk/password-hash && \
    printf '%s' "$hash" > /usr/lib/jetson-kiosk/password-hash

# DejaVu Sans covers Latin and Hebrew; the frontend must bundle any other font.
RUN dnf install -y gdm gnome-kiosk-script-session firefox dejavu-sans-fonts && \
    systemctl enable gdm && \
    systemctl set-default graphical.target && \
    dnf clean all

# sysusers and tmpfiles, not useradd and files in /var: /var in the image is
# not deployed.
COPY kiosk/sysusers.conf /usr/lib/sysusers.d/jetson-kiosk.conf
COPY kiosk/sysusers-credential.conf \
     /usr/lib/systemd/system/systemd-sysusers.service.d/50-jetson-kiosk.conf
COPY kiosk/tmpfiles.conf /usr/lib/tmpfiles.d/jetson-kiosk.conf
COPY --chmod=0555 kiosk/gnome-kiosk-script /usr/libexec/jetson-kiosk/gnome-kiosk-script

# No autologin: GDM asks for the kiosk password, which must not also open ssh
# or a text or serial console. login's stack refuses kiosk before anything
# else; GDM uses gdm-password, so the screen still logs in.
COPY kiosk/sshd-deny-kiosk.conf /etc/ssh/sshd_config.d/40-jetson-kiosk.conf
RUN sed -i '0,/^account/s//account    required     pam_succeed_if.so quiet_success user != kiosk\n&/' \
        /etc/pam.d/login && \
    grep -m1 '^account' /etc/pam.d/login | grep -q 'user != kiosk' || \
    { echo "/etc/pam.d/login has no account line to put the kiosk rule before"; exit 1; }

# First by name, so no later rule can answer for kiosk.
COPY kiosk/polkit-deny-kiosk.rules /usr/share/polkit-1/rules.d/10-jetson-kiosk.rules

# JSON takes no comments: nothing that tries the internet, no disk cache
# (eMMC), no file:// pages (a file picker would browse the disk), no way out of
# the page: no troubleshoot mode, about:support, printing or extensions.
COPY kiosk/policies.json /etc/firefox/policies/policies.json

# /etc, so one device can point somewhere else without a rebuild.
COPY kiosk/jetson-kiosk.conf /etc/jetson-kiosk.conf

RUN bootc container lint
