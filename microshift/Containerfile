# 3/3. MicroShift 4.20. The apps layer supplies embed_image.sh and
# copy-embedded-images.service.
ARG BASE_IMAGE=ghcr.io/black-cloudlet/jetson-orin-bootc-apps:latest
FROM ${BASE_IMAGE}

# rhocp and fast-datapath are entitlement-gated: the build runs in a registered
# UBI container, or on a subscribed RHEL host where podman injects entitlement.
# No `dnf upgrade` — it could pull a kernel past the one the Tegra kmod is built
# against. --enablerepo avoids depending on dnf-plugins-core in the base.
# openshift-clients is `oc`: the microshift RPM ships no client at all, and
# without it the node cannot inspect its own cluster.
ARG USHIFT_VER=4.20
RUN dnf install -y \
        --enablerepo="rhocp-${USHIFT_VER}-for-rhel-9-$(uname -m)-rpms" \
        --enablerepo="fast-datapath-for-rhel-9-$(uname -m)-rpms" \
        firewalld jq microshift microshift-release-info openshift-clients && \
    systemctl enable microshift && \
    dnf clean all

# Trusted: pod CIDR and the host-endpoint IP are mandatory; the ClusterIP
# service CIDR is not, but pods reach CoreDNS and the API server through it.
# Public: 6443 is the MicroShift API, 443 the router's HTTPS.
RUN firewall-offline-cmd --zone=trusted --add-source=10.42.0.0/16 && \
    firewall-offline-cmd --zone=trusted --add-source=10.43.0.0/16 && \
    firewall-offline-cmd --zone=trusted --add-source=169.254.169.1 && \
    firewall-offline-cmd --zone=public --add-port=22/tcp && \
    firewall-offline-cmd --zone=public --add-port=443/tcp && \
    firewall-offline-cmd --zone=public --add-port=6443/tcp

# OVN images need the root subtree shared. Skipped on bare metal, where systemd
# has already done it.
RUN printf '[Unit]\n\
Description=Make root filesystem shared\n\
Before=microshift.service\n\
ConditionVirtualization=container\n\
[Service]\n\
Type=oneshot\n\
ExecStart=/usr/bin/mount --make-rshared /\n\
[Install]\n\
WantedBy=multi-user.target\n' > /usr/lib/systemd/system/microshift-make-rshared.service && \
    systemctl enable microshift-make-rshared.service

# Do not start before the apps layer has replayed the embedded images.
RUN mkdir -p /usr/lib/systemd/system/microshift.service.d && \
    printf '[Unit]\n\
Requires=copy-embedded-images.service\n\
After=copy-embedded-images.service\n' \
      > /usr/lib/systemd/system/microshift.service.d/microshift-copy-images.conf

# CRI-O needs the NVIDIA runtime before a pod can request a GPU. MicroShift
# applies the manifest through kustomize on first start.
ARG NVIDIA_DEVICE_PLUGIN_VER=v0.17.1
# .toml, not .conf: nvidia-ctk rewrites a drop-in path to a .toml extension and
# still exits 0, so asking for .conf silently produces a file by another name.
# CRI-O walks crio.conf.d and reads every file whatever the extension, and 99-
# still sorts after MicroShift's own 10- and 11- drop-ins.
RUN nvidia-ctk runtime configure --runtime=crio --set-as-default \
        --config=/etc/crio/crio.conf.d/99-nvidia.toml

RUN mkdir -p /etc/microshift/manifests && \
    curl -fsSL -o /etc/microshift/manifests/nvidia-device-plugin.yml \
      "https://raw.githubusercontent.com/NVIDIA/k8s-device-plugin/${NVIDIA_DEVICE_PLUGIN_VER}/deployments/static/nvidia-device-plugin.yml"

# Time slicing. The Orin has one iGPU, so without it exactly one pod can hold
# nvidia.com/gpu and every other GPU workload — KServe, the model server, a
# second inference pod — waits for the node to be drained of the first. Replicas
# advertise the same device N times; the driver interleaves the contexts. There
# is no memory isolation and no fairness guarantee between them, so N is a
# statement about how many workloads are expected to fit in the SOM's RAM, not a
# free multiplier.
#
# 1 turns sharing off: the plugin only replicates when replicas > 1, so the
# config file and its mount stay in place either way and the knob is one number.
# renameByDefault is left false, so the resource is still plain nvidia.com/gpu
# and the upstream manifest and stock pod specs need no further patching.
ARG GPU_TIME_SLICING_REPLICAS=4
RUN case "${GPU_TIME_SLICING_REPLICAS}" in \
      '' | *[!0-9]*) \
        echo "GPU_TIME_SLICING_REPLICAS is not a number: '${GPU_TIME_SLICING_REPLICAS}'" ; \
        exit 1 ;; \
    esac ; \
    [ "${GPU_TIME_SLICING_REPLICAS}" -ge 1 ] || \
      { echo "GPU_TIME_SLICING_REPLICAS must be at least 1; 1 disables sharing" ; \
        exit 1 ; } ; \
    printf 'apiVersion: v1\n\
kind: ConfigMap\n\
metadata:\n\
  name: nvidia-device-plugin-config\n\
  namespace: kube-system\n\
data:\n\
  config.yaml: |\n\
    version: v1\n\
    sharing:\n\
      timeSlicing:\n\
        resources:\n\
          - name: nvidia.com/gpu\n\
            replicas: %s\n' "${GPU_TIME_SLICING_REPLICAS}" \
      > /etc/microshift/manifests/nvidia-device-plugin-config.yaml

COPY microshift/nvidia-device-plugin-time-slicing.yaml \
      /etc/microshift/manifests/nvidia-device-plugin-time-slicing.yaml

RUN printf 'apiVersion: kustomize.config.k8s.io/v1beta1\n\
kind: Kustomization\n\
resources:\n\
  - nvidia-device-plugin.yml\n\
  - nvidia-device-plugin-config.yaml\n\
patches:\n\
  - path: nvidia-device-plugin-time-slicing.yaml\n' \
      > /etc/microshift/manifests/kustomization.yaml

# MicroShift's control plane, plus the device plugin image named by the manifest
# (which uses "- image:" list form, hence the field scan).
RUN --mount=type=secret,id=pullsecret,dst=/run/secrets/pull-secret.json \
    images="$(jq -r '.images[]' /usr/share/microshift/release/release-"$(uname -m)".json)" ; \
    images="${images} $(awk '{for(i=1;i<NF;i++) if($i=="image:"){gsub(/"/,"",$(i+1)); print $(i+1)}}' \
        /etc/microshift/manifests/nvidia-device-plugin.yml | sort -u)" ; \
    for img in ${images} ; do \
        /opt/physically-bound-images/embed_image.sh "${img}" \
            --authfile /run/secrets/pull-secret.json ; \
    done

RUN bootc container lint
