# Layer 2, shared. The physically-bound-images machinery: the scripts and the
# unit that replays the cache at boot. The images themselves go in services/.
ARG BASE_IMAGE=ghcr.io/black-cloudlet/jetson-orin-bootc-base:latest
FROM ${BASE_IMAGE}

ARG JTOP_VER=7.2.1
RUN dnf install -y python3 python3-pip && \
    pip3 install --prefix=/usr --no-cache-dir "jetson-stats==${JTOP_VER}" && \
    dnf clean all

# The cache is a plain directory, not an additional container store: an image
# upgrade overwrites one of those (RHEL-75827).
# Scripts from redhat-et/edge-ai-image-pipelines (Apache-2.0). The installed
# path keeps the long name — the unit below and both variant layers call it.
COPY --chmod=0555 base/physically-bound-images/embed_image.sh \
      /opt/physically-bound-images/embed_image.sh
COPY --chmod=0555 base/physically-bound-images/copy_embedded_images.sh \
      /opt/physically-bound-images/copy_embedded_images.sh

# No network-online: the copy is local-disk only, and waiting for a carrier that
# never comes would add wait-online's timeout to every boot.
COPY --chmod=0644 base/physically-bound-images/copy-embedded-images.service \
      /usr/lib/systemd/system/copy-embedded-images.service
RUN systemctl enable copy-embedded-images.service

RUN bootc container lint
